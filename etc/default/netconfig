# NetConfig service environment  (/etc/default/netconfig)
NETCONFIG_HOME=/var/lib/netconfig

# Optional: auto-unlock the credential vault for the web service on start.
# Storing the master here is less secure than unlocking via the console;
# leave commented unless you accept that trade-off.

# Optional: override the ssh client binary if not on the default PATH.
#NETCONFIG_SSH=/usr/bin/ssh

# Preferred unattended vault bootstrap: use systemd LoadCredential= so the secret
# is exposed to the service only under $CREDENTIALS_DIRECTORY/vault-master.
# Alternative root-only file path (migration/non-systemd):
#NETCONFIG_MASTER_FILE=/etc/netconfig/vault-master
# Legacy only; avoid plaintext secrets in environment files:
#NETCONFIG_MASTER=change-me

# Optional D.5 Phase 4D evidence signing fallback for non-systemd/manual execution.
# Prefer systemd LoadCredential=evidence-signing-key.pem:/secure/path/key.pem.
# The key file must be a regular Ed25519 PEM file with no group/world permissions.
#NETCONFIG_EVIDENCE_SIGNING_KEY_FILE=/etc/netconfig/evidence-signing-key.pem
# Optional fail-closed policy for all newly-created diagnostic/case bundles:
#NETCONFIG_EVIDENCE_SIGNING_REQUIRED=1
# Independent trust pins (comma-separated SHA256:<hex>) for offline/API verification.
# During planned key rotation, keep both old and new fingerprints until retained signed
# evidence no longer needs to be trusted.
#NETCONFIG_EVIDENCE_TRUSTED_FINGERPRINTS=SHA256:<64-hex-digest>

# PH-2 core PostgreSQL credential for non-systemd/manual deployments.
# Prefer systemd LoadCredential=postgres-core-password:/secure/path/password.
# Alternative protected file (must not be group/world writable):
#NETCONFIG_DB_PASSWORD_FILE=/etc/netconfig/postgres-core-password
# Legacy environment fallback only; avoid plaintext DB passwords here:
#NETCONFIG_DB_PASSWORD=change-me
