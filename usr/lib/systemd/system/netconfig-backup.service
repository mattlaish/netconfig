[Unit]
Description=NetConfig weekly config backup (collect all devices, keep 5 copies each)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=netconfig
Group=netconfig
EnvironmentFile=-/etc/default/netconfig
StateDirectory=netconfig
StateDirectoryMode=0750
# For unattended vault access, use a systemd drop-in with LoadCredential=
# vault-master:/root-or-secret-manager/netconfig-vault-master.
ExecStart=/usr/bin/netconfig backup --keep 5
# Needs the vault. Prefer systemd LoadCredential; legacy NETCONFIG_MASTER is
# supported only for compatibility.
