[Unit]
Description=NetConfig weekly config backup (collect all devices, keep 5 copies each)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=netconfig
Group=netconfig
EnvironmentFile=-/etc/default/netconfig
# Repair ownership first (runs as root via '+'), then back up as the service user.
ExecStartPre=+/bin/sh -c 'chown -R netconfig:netconfig /var/lib/netconfig 2>/dev/null || true'
ExecStart=/usr/bin/netconfig backup --keep 5
# Needs the vault: set NETCONFIG_MASTER in /etc/default/netconfig, or the run
# logs a clear "vault locked" message and does nothing.
