[Unit]
Description=NetConfig web console (Security Operations)
Documentation=file:/opt/netconfig/INSTALL.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netconfig
Group=netconfig
EnvironmentFile=-/etc/default/netconfig
# Self-heal: if the CLI was ever run as root, its files end up root-owned and the
# service (running as netconfig) can't write -> unlock/collect fail. Repair on every
# start. The '+' prefix runs this step as root regardless of User= above.
ExecStartPre=+/bin/sh -c 'chown -R netconfig:netconfig /var/lib/netconfig 2>/dev/null || true'
ExecStart=/usr/bin/netconfig web
Restart=on-failure
RestartSec=3

# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/netconfig
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
