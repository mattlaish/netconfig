[Unit]
Description=NetConfig web console (Security Operations)
Documentation=file:/opt/netconfig/INSTALL.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netconfig
Group=netconfig
EnvironmentFile=-/etc/default/netconfig
# systemd creates and owns /var/lib/netconfig for the service. Avoid recursive
# root chown on every start; package/install migration should repair legacy ownership.
StateDirectory=netconfig
StateDirectoryMode=0750
# Optional production secret bootstrap (recommended): add a systemd drop-in with
# LoadCredential=vault-master:/root-or-secret-manager/netconfig-vault-master
# NetConfig automatically reads $CREDENTIALS_DIRECTORY/vault-master.
# Optional evidence signing: a drop-in may also use
# LoadCredential=evidence-signing-key.pem:/secure/path/evidence-signing-key.pem
# PH-2 PostgreSQL core password (needed before the NetConfig vault opens):
# LoadCredential=postgres-core-password:/secure/path/netconfig-postgres-password
# NetConfig reads only these credential files; secrets are never stored in settings.json.
ExecStart=/usr/bin/netconfig web
Restart=on-failure
RestartSec=3

# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/netconfig
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
